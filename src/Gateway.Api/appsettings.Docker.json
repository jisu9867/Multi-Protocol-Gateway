{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Gateway.Api": "Information",
      "Gateway.Api.Services.PipelineService": "Information",
      "Gateway.Adapters.MqttAdapter": "Information",
      "Gateway.Infrastructure.Kafka": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=gateway;Username=gateway;Password=gateway"
  },
  "Sinks": {
    "PostgreSql": { "BatchSize": 100, "FlushIntervalMs": 500 },
    "JsonlFile": { "BasePath": "logs", "BatchSize": 50, "FlushIntervalMs": 2000 }
  },
  "Adapters": {
    "EnableFakeAdapter": false,
    "Mqtt": {
      "Enabled": true,
      "Server": "mosquitto",
      "Port": 1883,
      "Topic": "factory/+/+/telemetry"
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:9093",
    "Topic": "telemetry-events",
    "ConsumerGroupId": "gateway-consumer-group",
    "Producer": { "EnableIdempotence": true, "Acks": "all", "Retries": 3, "BatchSize": 16384, "LingerMs": 10 },
    "Consumer": { "EnableAutoCommit": false, "AutoOffsetReset": "earliest", "MaxPollRecords": 100, "SessionTimeoutMs": 30000, "EnableAutoOffsetStore": false }
  },
  "Gateway": { "EnableSeedData": true },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": { "Microsoft": "Warning", "System": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
