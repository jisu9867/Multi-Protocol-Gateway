@using Gateway.Ui.Models
@using Gateway.Ui.Services
@using Gateway.Core.Models
@using FactoryEnum = Gateway.Core.Models.Factory
@using System.Text.Json
@implements IAsyncDisposable

<div class="modal-overlay" @onclick="CloseModal">
    <div class="modal-content" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2>@GetTitle()</h2>
            <button class="modal-close" @onclick="CloseModal">×</button>
        </div>
        <div class="modal-body">
            @if (!_isConnected)
            {
                <div class="loading-message">
                    <div>Connecting to real-time data stream...</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">
                        Factory: @FactoryId, Tag: @MapSensorTypeToTag(Sensor?.Type ?? "")
                    </div>
                </div>
            }
            else if (_dataPoints.Count == 0)
            {
                <div class="loading-message">
                    <div>Waiting for data...</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">
                        Factory: @FactoryId, Tag: @MapSensorTypeToTag(Sensor?.Type ?? "")
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                        Listening for events from all sources...
                    </div>
                </div>
            }
            else
            {
                <div class="chart-legend">
                    @foreach (var series in _seriesData.Values)
                    {
                        <div class="legend-item">
                            <span class="legend-color" style="background-color: @series.Color"></span>
                            <span class="legend-label">@series.EquipmentName</span>
                        </div>
                    }
                </div>
                <div class="realtime-chart-container">
                    <svg class="realtime-chart" viewBox="0 0 800 400">
                        @* Grid lines *@
                        @for (int i = 0; i <= 10; i++)
                        {
                            var y = 30 + i * 35;
                            <line x1="60" y1="@y" x2="780" y2="@y" class="chart-grid-line" stroke-dasharray="2,2" />
                        }
                        
                        @* Draw each series *@
                        @foreach (var series in _seriesData.Values)
                        {
                            <path d="@GetLinePath(series.DataPoints)" 
                                  class="chart-line" 
                                  style="stroke: @series.Color; fill: none; stroke-width: 2;" />
                            
                            @* Data points *@
                            @foreach (var point in series.DataPoints)
                            {
                                var x = GetXByIndex(point);
                                var y = GetY(point.Value);
                                <circle cx="@x" cy="@y" r="3" fill="@series.Color" />
                            }
                        }
                        
                        @* X-axis labels (time) - show actual time for each data point, evenly distributed *@
                        @if (_dataPoints.Count > 0)
                        {
                            var labelCount = Math.Min(_dataPoints.Count, 10);
                            for (int i = 0; i < labelCount; i++)
                            {
                                var index = i;
                                if (index >= 0 && index < _dataPoints.Count)
                                {
                                    var point = _dataPoints[index];
                                    var x = GetXByIndex(point);
                                    var time = point.Timestamp;
                                    @((MarkupString)$"<text x=\"{x}\" y=\"390\" class=\"chart-axis-label\" text-anchor=\"middle\">{time:HH:mm:ss}</text>")
                                }
                            }
                        }
                        
                        @* Y-axis labels (value) *@
                        @for (int i = 0; i <= 10; i++)
                        {
                            var y = 30 + i * 35;
                            var value = _maxValue - (_maxValue - _minValue) / 10 * i;
                            @((MarkupString)$"<text x=\"55\" y=\"{y + 4}\" class=\"chart-axis-label\" text-anchor=\"end\">{value:F1}</text>")
                        }
                    </svg>
                </div>
                <div class="chart-stats">
                    <div>Data Points: @_dataPoints.Count</div>
                    <div>Last Update: @(_lastUpdateTime?.ToString("HH:mm:ss") ?? "N/A")</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public SensorData? Sensor { get; set; }
    [Parameter] public FactoryEnum FactoryId { get; set; }
    [Parameter] public int? LineNumber { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Inject] private SignalRService SignalRService { get; set; } = null!;
    [Inject] private ILogger<RealtimeSensorChart> Logger { get; set; } = null!;
    [Inject] private HttpClient HttpClient { get; set; } = null!;
    [Inject] private IConfiguration Configuration { get; set; } = null!;

    private List<TelemetryEventDto> _dataPoints = new();
    private Dictionary<string, SeriesData> _seriesData = new();
    private bool _isConnected = false;
    private double _minValue = 0;
    private double _maxValue = 100;
    private DateTime? _lastUpdateTime;
    private const int MaxDataPoints = 10; // Keep last 10 points

    protected override async Task OnInitializedAsync()
    {
        if (Sensor == null)
        {
            Logger.LogWarning("Sensor is null, cannot initialize real-time chart");
            return;
        }

        try
        {
            Logger.LogInformation("Initializing real-time chart for sensor: {SensorId}, Type={SensorType}", Sensor.Id, Sensor.Type);
            
            // Extract factory ID and tag from sensor
            var factoryId = FactoryId.ToString();
            var tag = MapSensorTypeToTag(Sensor.Type);
            
            // Extract SourceId from Sensor.Id (format: {factory}-line{number} or just sourceId)
            var sourceId = Sensor.Id;
            
            Logger.LogInformation("Loading initial data for Factory={FactoryId}, Tag={Tag}, SourceId={SourceId}", factoryId, tag, sourceId);
            
            // Load initial latest data before subscribing to real-time updates
            await LoadInitialDataAsync(factoryId, tag, sourceId);
            
            Logger.LogInformation("Initial data loaded. Data points count: {Count}", _dataPoints.Count);
            
            // Force UI update after loading initial data
            StateHasChanged();
            
            await SignalRService.StartAsync();
            _isConnected = SignalRService.IsConnected;
            
            if (!_isConnected)
            {
                Logger.LogError("SignalR connection failed");
                return;
            }

            // Subscribe to specific sourceId for this factory and tag
            Logger.LogInformation("Subscribing to: Factory={FactoryId}, Tag={Tag}, SourceId={SourceId}", 
                factoryId, tag, sourceId);

            // Register callback for receiving events BEFORE subscribing
            SignalRService.OnReceiveTelemetryEvent(OnTelemetryEventReceived);

            // Subscribe to sensor updates for specific sourceId
            await SignalRService.SubscribeToSensorAsync(factoryId, tag, sourceId);

            Logger.LogInformation("Successfully subscribed to real-time sensor data");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing real-time chart");
            _isConnected = false;
        }
    }

    private async Task LoadInitialDataAsync(string factoryId, string tag, string sourceId)
    {
        try
        {
            Logger.LogInformation("Loading initial latest data for Factory={FactoryId}, Tag={Tag}", factoryId, tag);
            
            // Get latest events from API - use tag filter to get only relevant events
            // Use the same base URL as TelemetryDataService
            var apiBaseUrl = Configuration["GatewayApi:BaseUrl"] ?? "http://localhost:5011";
            if (apiBaseUrl.EndsWith("/"))
            {
                apiBaseUrl = apiBaseUrl.TrimEnd('/');
            }
            
            // Parse factoryId string to enum for API call
            FactoryEnum? factoryEnum = null;
            if (Enum.TryParse<FactoryEnum>(factoryId, ignoreCase: true, out var parsedFactory))
            {
                factoryEnum = parsedFactory;
            }
            
            // Get recent events filtered by factory, tag, and sourceId
            // Get enough events to ensure we have MaxDataPoints for this specific sourceId
            var url = factoryEnum.HasValue
                ? $"{apiBaseUrl}/api/events/recent?factoryId={factoryEnum.Value}&tag={Uri.EscapeDataString(tag)}&sourceId={Uri.EscapeDataString(sourceId)}&limit={MaxDataPoints * 2}" // Get more to ensure we have enough
                : $"{apiBaseUrl}/api/events/recent?tag={Uri.EscapeDataString(tag)}&sourceId={Uri.EscapeDataString(sourceId)}&limit={MaxDataPoints * 2}";
            
            Logger.LogInformation("Calling API: {Url}", url);
            var response = await HttpClient.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                Logger.LogInformation("Received {Length} bytes from API", json.Length);
                
                var options = new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };
                
                // Deserialize as dynamic objects first, then convert to TelemetryEventDto
                var rawEvents = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(json, options) ?? new List<System.Text.Json.JsonElement>();
                Logger.LogInformation("Deserialized {Count} raw events from API", rawEvents.Count);
                
                var events = new List<TelemetryEventDto>();
                foreach (var element in rawEvents)
                {
                    try
                    {
                        // Extract value from ValueJson (which is a JSON string or object)
                        // API returns "value" as ValueJson which can be a JSON string
                        var valueJson = element.TryGetProperty("value", out var valueProp) ? valueProp : default;
                        var value = ExtractValueFromJson(valueJson);
                        
                        // Parse EventId (can be Guid or string)
                        Guid eventIdGuid = Guid.Empty;
                        if (element.TryGetProperty("eventId", out var eventIdProp))
                        {
                            if (eventIdProp.ValueKind == System.Text.Json.JsonValueKind.String)
                            {
                                Guid.TryParse(eventIdProp.GetString(), out eventIdGuid);
                            }
                        }
                        
                        // Parse FactoryId (can be enum int or string)
                        string parsedFactoryId = factoryId;
                        if (element.TryGetProperty("factoryId", out var factoryIdProp))
                        {
                            if (factoryIdProp.ValueKind == System.Text.Json.JsonValueKind.String)
                            {
                                parsedFactoryId = factoryIdProp.GetString() ?? factoryId;
                            }
                            else if (factoryIdProp.ValueKind == System.Text.Json.JsonValueKind.Number)
                            {
                                // Convert enum int to string
                                var enumValue = factoryIdProp.GetInt32();
                                if (Enum.IsDefined(typeof(FactoryEnum), enumValue))
                                {
                                    parsedFactoryId = ((FactoryEnum)enumValue).ToString();
                                }
                            }
                        }
                        
                        // Extract tag
                        var eventTag = element.TryGetProperty("tag", out var tagProp) 
                            ? tagProp.GetString() ?? "" 
                            : "";
                        
                        // Convert to TelemetryEventDto
                        var eventDto = new TelemetryEventDto
                        {
                            EventId = eventIdGuid,
                            Timestamp = element.TryGetProperty("timestamp", out var tsProp) 
                                ? tsProp.GetDateTimeOffset() 
                                : DateTimeOffset.Now,
                            FactoryId = parsedFactoryId,
                            SourceId = element.TryGetProperty("sourceId", out var sourceIdProp) 
                                ? (sourceIdProp.ValueKind == System.Text.Json.JsonValueKind.String 
                                    ? sourceIdProp.GetString() ?? "" 
                                    : sourceIdProp.GetRawText().Trim('"'))
                                : "",
                            EquipmentType = element.TryGetProperty("equipmentType", out var eqTypeProp) 
                                ? (eqTypeProp.ValueKind == System.Text.Json.JsonValueKind.String 
                                    ? eqTypeProp.GetString() ?? "" 
                                    : eqTypeProp.GetRawText().Trim('"'))
                                : "",
                            EquipmentName = element.TryGetProperty("equipmentName", out var eqNameProp) 
                                ? (eqNameProp.ValueKind == System.Text.Json.JsonValueKind.String 
                                    ? eqNameProp.GetString() ?? "" 
                                    : eqNameProp.GetRawText().Trim('"'))
                                : "",
                            Tag = eventTag,
                            Value = value,
                            Quality = element.TryGetProperty("quality", out var qualityProp) 
                                ? (qualityProp.ValueKind == System.Text.Json.JsonValueKind.String 
                                    ? qualityProp.GetString() ?? "Good"
                                    : qualityProp.ValueKind == System.Text.Json.JsonValueKind.Number
                                        ? ((qualityProp.GetInt32() == 0) ? "Good" : qualityProp.GetInt32().ToString())
                                        : "Good")
                                : "Good",
                            Sequence = element.TryGetProperty("sequence", out var seqProp) 
                                ? seqProp.GetInt64() 
                                : 0
                        };
                        
                        events.Add(eventDto);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to parse event: {EventJson}", element.GetRawText());
                    }
                }
                
                Logger.LogInformation("Parsed {Count} events matching tag {Tag}", events.Count, tag);
                
                // Filter by sourceId to get only events for this specific sensor
                var filteredEvents = events
                    .Where(e => e.SourceId.Equals(sourceId, StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(e => e.Timestamp)
                    .Take(MaxDataPoints)
                    .OrderBy(e => e.Timestamp) // Sort ascending for display
                    .ToList();
                
                Logger.LogInformation("Filtered to {Count} events for SourceId={SourceId} (max {MaxPoints})", 
                    filteredEvents.Count, sourceId, MaxDataPoints);
                
                // Initialize series data for this specific sourceId
                _seriesData.Clear();
                _dataPoints.Clear();
                
                if (filteredEvents.Any())
                {
                    _seriesData[sourceId] = new SeriesData
                    {
                        SourceId = sourceId,
                        EquipmentName = filteredEvents.First().EquipmentName,
                        Color = GetColorForSeries(0),
                        DataPoints = filteredEvents
                    };
                    
                    _dataPoints = filteredEvents;
                }
                
                Logger.LogInformation("Loaded {Count} initial data points for SourceId={SourceId}", 
                    _dataPoints.Count, sourceId);
                
                if (_dataPoints.Any())
                {
                    // Update min/max values
                    UpdateMinMax();
                    
                    _lastUpdateTime = DateTime.Now;
                    Logger.LogInformation("Initialized chart with {Count} data points, {SeriesCount} series", _dataPoints.Count, _seriesData.Count);
                    StateHasChanged();
                }
                else
                {
                    Logger.LogInformation("No initial data found for Factory={FactoryId}, Tag={Tag}, SourceId={SourceId}", factoryId, tag, sourceId);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Failed to load initial data: {StatusCode}, Response: {Response}", response.StatusCode, errorContent);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading initial data: {Message}", ex.Message);
        }
    }
    
    private double ExtractValueFromJson(System.Text.Json.JsonElement valueElement)
    {
        if (valueElement.ValueKind == System.Text.Json.JsonValueKind.Undefined || 
            valueElement.ValueKind == System.Text.Json.JsonValueKind.Null)
        {
            return 0;
        }
        
        if (valueElement.ValueKind == System.Text.Json.JsonValueKind.Number)
        {
            return valueElement.GetDouble();
        }
        else if (valueElement.ValueKind == System.Text.Json.JsonValueKind.String)
        {
            var str = valueElement.GetString();
            if (string.IsNullOrEmpty(str))
            {
                return 0;
            }
            
            // Try parsing as number first
            if (double.TryParse(str, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedValue))
            {
                return parsedValue;
            }
            
            // Try parsing as JSON string
            try
            {
                var jsonDoc = System.Text.Json.JsonDocument.Parse(str);
                return ExtractValueFromJson(jsonDoc.RootElement);
            }
            catch
            {
                return 0;
            }
        }
        else if (valueElement.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            // Try to get "value" property
            if (valueElement.TryGetProperty("value", out var nestedValue))
            {
                return ExtractValueFromJson(nestedValue);
            }
            
            // If no "value" property, try to get first numeric property
            foreach (var prop in valueElement.EnumerateObject())
            {
                if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    return prop.Value.GetDouble();
                }
            }
        }
        return 0;
    }

    private void OnTelemetryEventReceived(TelemetryEventDto eventDto)
    {
        Logger.LogInformation("Received event: Factory={FactoryId}, Tag={Tag}, SourceId={SourceId}, Value={Value}", 
            eventDto.FactoryId, eventDto.Tag, eventDto.SourceId, eventDto.Value);
        
        // Filter by factory, tag, and sourceId
        var tag = MapSensorTypeToTag(Sensor?.Type ?? "");
        var expectedFactoryId = FactoryId.ToString();
        var expectedSourceId = Sensor?.Id ?? "";
        
        // Check if this event matches our subscription
        bool matchesFactory = eventDto.FactoryId.Equals(expectedFactoryId, StringComparison.OrdinalIgnoreCase);
        bool matchesTag = eventDto.Tag.Equals(tag, StringComparison.OrdinalIgnoreCase);
        bool matchesSourceId = eventDto.SourceId.Equals(expectedSourceId, StringComparison.OrdinalIgnoreCase);
        
        if (!matchesFactory || !matchesTag || !matchesSourceId)
        {
            Logger.LogDebug("Event filtered out: Factory={MatchesFactory}, Tag={MatchesTag}, SourceId={MatchesSourceId} (Expected={ExpectedSourceId}, Got={GotSourceId})", 
                matchesFactory, matchesTag, matchesSourceId, expectedSourceId, eventDto.SourceId);
            return;
        }

        Logger.LogInformation("Processing event: Factory={FactoryId}, Tag={Tag}, SourceId={SourceId}, Value={Value}", 
            eventDto.FactoryId, eventDto.Tag, eventDto.SourceId, eventDto.Value);

        InvokeAsync(() =>
        {
            // Group by SourceId for multiple lines
            var key = eventDto.SourceId;
            if (!_seriesData.ContainsKey(key))
            {
                _seriesData[key] = new SeriesData
                {
                    SourceId = key,
                    EquipmentName = eventDto.EquipmentName,
                    Color = GetColorForSeries(_seriesData.Count),
                    DataPoints = new List<TelemetryEventDto>()
                };
            }

            // Add new event to the series (append to existing data, don't replace)
            // Check if this event already exists (by EventId or timestamp + sourceId) to avoid duplicates
            var existingEvent = _seriesData[key].DataPoints.FirstOrDefault(p => 
                (p.EventId != Guid.Empty && p.EventId == eventDto.EventId) ||
                (p.Timestamp == eventDto.Timestamp && p.SourceId == eventDto.SourceId));
            
            if (existingEvent == null)
            {
                // Add new event to the end of the list
                _seriesData[key].DataPoints.Add(eventDto);
                
                // Sort by timestamp to maintain chronological order
                _seriesData[key].DataPoints = _seriesData[key].DataPoints
                    .OrderBy(e => e.Timestamp)
                    .ToList();
                
                // Keep only last MaxDataPoints per series (FIFO: remove oldest if exceeds limit)
                if (_seriesData[key].DataPoints.Count > MaxDataPoints)
                {
                    // Remove the oldest (first) data points
                    var removeCount = _seriesData[key].DataPoints.Count - MaxDataPoints;
                    _seriesData[key].DataPoints.RemoveRange(0, removeCount);
                }
            }
            else
            {
                // Update existing event if needed
                var index = _seriesData[key].DataPoints.IndexOf(existingEvent);
                if (index >= 0)
                {
                    _seriesData[key].DataPoints[index] = eventDto;
                }
            }

            // Rebuild _dataPoints from all series (sorted by timestamp)
            _dataPoints.Clear();
            foreach (var series in _seriesData.Values)
            {
                _dataPoints.AddRange(series.DataPoints);
            }
            _dataPoints = _dataPoints
                .OrderBy(e => e.Timestamp)
                .ToList();

            // Update min/max values
            UpdateMinMax();

            _lastUpdateTime = DateTime.Now;
            StateHasChanged();
        });
    }

    private void UpdateMinMax()
    {
        if (_dataPoints.Count == 0)
        {
            return;
        }

        var allValues = _dataPoints.Select(d => d.Value).ToList();
        _minValue = allValues.Min() - (allValues.Max() - allValues.Min()) * 0.1;
        _maxValue = allValues.Max() + (allValues.Max() - allValues.Min()) * 0.1;

        if (_maxValue == _minValue)
        {
            _maxValue = _minValue + 10;
        }
    }

    private double GetXByIndex(TelemetryEventDto point)
    {
        if (_dataPoints.Count == 0) return 60;
        
        // Find the index of this point in _dataPoints
        var index = _dataPoints.FindIndex(p => 
            (p.EventId != Guid.Empty && p.EventId == point.EventId) || 
            (p.Timestamp == point.Timestamp && p.SourceId == point.SourceId));
        
        if (index < 0)
        {
            // If not found, try to find by timestamp and sourceId
            index = _dataPoints.FindIndex(p => p.Timestamp == point.Timestamp && p.SourceId == point.SourceId);
        }
        
        if (index < 0)
        {
            // If still not found, try to find by timestamp only
            index = _dataPoints.FindIndex(p => p.Timestamp == point.Timestamp);
        }
        
        if (index < 0)
        {
            // If still not found, use the last position
            index = _dataPoints.Count - 1;
        }
        
        // Distribute points evenly across the width (60 to 780 = 720 pixels)
        var totalPoints = Math.Min(_dataPoints.Count, MaxDataPoints);
        if (totalPoints <= 1) return 60;
        
        var ratio = (double)index / (totalPoints - 1);
        return 60 + ratio * 720; // 60 to 780
    }
    
    private double GetX(DateTimeOffset timestamp)
    {
        // This method is kept for backward compatibility but should use GetXByIndex instead
        if (_dataPoints.Count == 0) return 60;
        
        var timeSpan = timestamp - _dataPoints[0].Timestamp;
        var totalSpan = _dataPoints.Last().Timestamp - _dataPoints[0].Timestamp;
        
        if (totalSpan.TotalSeconds == 0) return 60;
        
        var ratio = timeSpan.TotalSeconds / totalSpan.TotalSeconds;
        return 60 + ratio * 720; // 60 to 780
    }

    private double GetY(double value)
    {
        var range = _maxValue - _minValue;
        if (range == 0) return 200;
        
        var ratio = (value - _minValue) / range;
        return 30 + (1 - ratio) * 350; // 30 to 380
    }

    private string GetLinePath(List<TelemetryEventDto> points)
    {
        if (points.Count == 0) return "";
        
        var path = new System.Text.StringBuilder();
        for (int i = 0; i < points.Count; i++)
        {
            var x = GetXByIndex(points[i]);
            var y = GetY(points[i].Value);
            
            if (i == 0)
            {
                path.Append($"M {x:F1},{y:F1}");
            }
            else
            {
                path.Append($" L {x:F1},{y:F1}");
            }
        }
        
        return path.ToString();
    }

    private string GetTitle()
    {
        if (Sensor == null) return "Real-time Sensor Data";
        return $"{Sensor.Name} - Real-time";
    }

    private string MapSensorTypeToTag(string sensorType)
    {
        return sensorType.ToLower() switch
        {
            "temperature" => "temp",
            "humidity" => "humidity",
            "pressure" => "pressure",
            "vibration" => "vibration",
            "power" => "power",
            "flow" => "flow",
            _ => sensorType.ToLower()
        };
    }

    private string GetColorForSeries(int index)
    {
        var colors = new[] { "#10b981", "#3b82f6", "#f59e0b", "#ef4444", "#8b5cf6", "#06b6d4" };
        return colors[index % colors.Length];
    }

    private async Task CloseModal()
    {
        if (Sensor != null)
        {
            var factoryId = FactoryId.ToString();
            var tag = MapSensorTypeToTag(Sensor.Type);
            var sourceId = Sensor.Id;
            await SignalRService.UnsubscribeFromSensorAsync(factoryId, tag, sourceId);
            SignalRService.RemoveCallback(OnTelemetryEventReceived);
        }
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (Sensor != null)
        {
            var factoryId = FactoryId.ToString();
            var tag = MapSensorTypeToTag(Sensor.Type);
            var sourceId = Sensor.Id;
            await SignalRService.UnsubscribeFromSensorAsync(factoryId, tag, sourceId);
            SignalRService.RemoveCallback(OnTelemetryEventReceived);
        }
    }

    private class SeriesData
    {
        public string SourceId { get; set; } = string.Empty;
        public string EquipmentName { get; set; } = string.Empty;
        public string Color { get; set; } = "#10b981";
        public List<TelemetryEventDto> DataPoints { get; set; } = new();
    }
}

