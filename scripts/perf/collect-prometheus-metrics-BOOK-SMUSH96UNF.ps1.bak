param(
    [Parameter(Mandatory = $true)]
    [string]$StageName,
    [Parameter(Mandatory = $true)]
    [int]$TargetTps,
    [Parameter(Mandatory = $true)]
    [int]$PartitionCount,
    [Parameter(Mandatory = $true)]
    [datetime]$StartUtc,
    [Parameter(Mandatory = $true)]
    [datetime]$SteadyStartUtc,
    [Parameter(Mandatory = $true)]
    [datetime]$SteadyEndUtc,
    [Parameter(Mandatory = $true)]
    [datetime]$EndUtc,
    [string]$PrometheusBaseUrl = "http://localhost:9090",
    [string]$OutputDir = "",
    [switch]$EnablePostgresFallback = $true,
    [string]$KafkaStorageConsumerGroupPattern = "gateway-consumer-group.*",
    [double]$ErrorRateThresholdPercent = 0.1,
    [double]$KafkaP95ThresholdSeconds = 1.0,
    [double]$MqttP95ThresholdSeconds = 0.1,
    [double]$LagRecoveryThreshold = 100
)

$ErrorActionPreference = "Stop"

$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$gatewayRoot = Resolve-Path (Join-Path $scriptDir "..\..")
if (-not $OutputDir) {
    $OutputDir = Join-Path $gatewayRoot "artifacts\perf\$StageName"
}
New-Item -ItemType Directory -Path $OutputDir -Force | Out-Null

function Convert-ToUnix {
    param([datetime]$Dt)
    if ($Dt.Kind -eq [DateTimeKind]::Unspecified) {
        $Dt = [DateTime]::SpecifyKind($Dt, [DateTimeKind]::Utc)
    }
    $dto = [DateTimeOffset]$Dt
    return $dto.ToUnixTimeSeconds()
}

function Invoke-PromQueryRange {
    param(
        [string]$Query,
        [datetime]$RangeStartUtc,
        [datetime]$RangeEndUtc,
        [int]$StepSeconds = 30
    )
    $qs = [uri]::EscapeDataString($Query)
    $start = Convert-ToUnix $RangeStartUtc
    $end = Convert-ToUnix $RangeEndUtc
    $url = "$PrometheusBaseUrl/api/v1/query_range?query=$qs&start=$start&end=$end&step=$StepSeconds"
    $resp = Invoke-RestMethod -Uri $url -Method Get
    if ($resp.status -ne "success") {
        throw "Prometheus query_range failed: $Query"
    }
    return $resp.data.result
}

function Invoke-PromQueryInstant {
    param(
        [string]$Query,
        [datetime]$AtUtc
    )
    $qs = [uri]::EscapeDataString($Query)
    $time = Convert-ToUnix $AtUtc
    $url = "$PrometheusBaseUrl/api/v1/query?query=$qs&time=$time"
    $resp = Invoke-RestMethod -Uri $url -Method Get
    if ($resp.status -ne "success") {
        throw "Prometheus query failed: $Query"
    }
    return $resp.data.result
}

function Get-SeriesValues {
    param($Series)
    $values = @()
    foreach ($row in $Series.values) {
        if ($null -eq $row -or $row.Count -lt 2) { continue }
        $raw = "$($row[1])"
        if ([string]::IsNullOrWhiteSpace($raw)) { continue }
        try {
            $v = [double]::Parse($raw, [System.Globalization.CultureInfo]::InvariantCulture)
            if (-not [double]::IsNaN($v) -and -not [double]::IsInfinity($v)) {
                $values += $v
            }
        }
        catch {
            continue
        }
    }
    return $values
}

function Get-Stats {
    param([double[]]$Values)
    if (-not $Values -or $Values.Count -eq 0) {
        return [pscustomobject]@{ avg = 0.0; min = 0.0; max = 0.0 }
    }
    return [pscustomobject]@{
        avg = [double](($Values | Measure-Object -Average).Average)
        min = [double](($Values | Measure-Object -Minimum).Minimum)
        max = [double](($Values | Measure-Object -Maximum).Maximum)
    }
}

function Get-FirstSeriesStats {
    param(
        [string]$Query,
        [datetime]$RangeStartUtc,
        [datetime]$RangeEndUtc
    )
    $result = Invoke-PromQueryRange -Query $Query -RangeStartUtc $RangeStartUtc -RangeEndUtc $RangeEndUtc
    if (-not $result -or $result.Count -eq 0) {
        return Get-Stats -Values @()
    }
    $values = Get-SeriesValues -Series $result[0]
    return Get-Stats -Values $values
}

function Get-PrimaryValueOrZero {
    param($Result)
    if (-not $Result -or $Result.Count -eq 0) { return 0.0 }
    if (-not $Result[0].value -or $Result[0].value.Count -lt 2) { return 0.0 }
    $raw = "$($Result[0].value[1])"
    if ([string]::IsNullOrWhiteSpace($raw)) { return 0.0 }
    try {
        $v = [double]::Parse($raw, [System.Globalization.CultureInfo]::InvariantCulture)
        if ([double]::IsNaN($v) -or [double]::IsInfinity($v)) { return 0.0 }
        return $v
    }
    catch {
        return 0.0
    }
}

function Get-CounterRateStats {
    param(
        [Parameter(Mandatory = $true)]
        [string]$CounterExpr,
        [Parameter(Mandatory = $true)]
        [datetime]$RangeStartUtc,
        [Parameter(Mandatory = $true)]
        [datetime]$RangeEndUtc,
        [int[]]$RateWindowsMinutes = @(1, 2, 5)
    )
    foreach ($w in $RateWindowsMinutes) {
        if ($w -le 0) { continue }
        $query = "sum(rate($CounterExpr[$($w)m]))"
        $stats = Get-FirstSeriesStats -Query $query -RangeStartUtc $RangeStartUtc -RangeEndUtc $RangeEndUtc
        if ($stats.max -gt 0 -or $stats.avg -gt 0 -or $stats.min -gt 0) {
            return $stats
        }
    }

    $steadySeconds = [Math]::Max(1.0, ($RangeEndUtc - $RangeStartUtc).TotalSeconds)
    $steadyMinutes = [int][Math]::Max(1, [Math]::Ceiling($steadySeconds / 60.0))
    $fallbackQuery = "sum(increase($CounterExpr[$($steadyMinutes)m])) / $steadySeconds"
    $instant = Invoke-PromQueryInstant -Query $fallbackQuery -AtUtc $RangeEndUtc
    $avg = Get-PrimaryValueOrZero -Result $instant
    return [pscustomobject]@{
        avg = $avg
        min = $avg
        max = $avg
    }
}

function Resolve-ExpressionCandidate {
    param(
        [string[]]$Candidates,
        [datetime]$RangeStartUtc,
        [datetime]$RangeEndUtc
    )
    foreach ($expr in $Candidates) {
        $series = Invoke-PromQueryRange -Query $expr -RangeStartUtc $RangeStartUtc -RangeEndUtc $RangeEndUtc -StepSeconds 30
        if ($series -and $series.Count -gt 0) {
            return $expr
        }
    }
    return $null
}

function Get-CounterThroughputStats {
    param(
        [string[]]$CounterExprCandidates,
        [datetime]$RangeStartUtc,
        [datetime]$RangeEndUtc
    )
    $resolvedExpr = Resolve-ExpressionCandidate -Candidates $CounterExprCandidates -RangeStartUtc $RangeStartUtc -RangeEndUtc $RangeEndUtc
    if (-not $resolvedExpr) {
        return [pscustomobject]@{
            expr = ""
            has_data = $false
            avg = 0.0
            min = 0.0
            max = 0.0
        }
    }

    $steadySeconds = [Math]::Max(1.0, ($RangeEndUtc - $RangeStartUtc).TotalSeconds)
    $steadyMinutes = [int][Math]::Max(1, [Math]::Ceiling($steadySeconds / 60.0))
    $avgQuery = "sum(increase($resolvedExpr[$($steadyMinutes)m])) / $steadySeconds"
    $avgResult = Invoke-PromQueryInstant -Query $avgQuery -AtUtc $RangeEndUtc
    $avgValue = Get-PrimaryValueOrZero -Result $avgResult

    $rateStats = Get-CounterRateStats -CounterExpr $resolvedExpr -RangeStartUtc $RangeStartUtc -RangeEndUtc $RangeEndUtc
    if ($rateStats.avg -le 0 -and $avgValue -gt 0) {
        $rateStats = [pscustomobject]@{
            avg = $avgValue
            min = $avgValue
            max = $avgValue
        }
    }
    else {
        $rateStats = [pscustomobject]@{
            avg = $avgValue
            min = $rateStats.min
            max = $rateStats.max
        }
    }

    return [pscustomobject]@{
        expr = $resolvedExpr
        has_data = $true
        avg = $rateStats.avg
        min = $rateStats.min
        max = $rateStats.max
    }
}

function Get-DbPersistTpsFromPostgres {
    param(
        [datetime]$RangeStartUtc,
        [datetime]$RangeEndUtc
    )
    $steadySeconds = [Math]::Max(1.0, ($RangeEndUtc - $RangeStartUtc).TotalSeconds)
    $startEpoch = Convert-ToUnix $RangeStartUtc
    $endEpoch = Convert-ToUnix $RangeEndUtc
    $sql = @"
SELECT COUNT(*)
FROM telemetry_events
WHERE "timestamp" >= (to_timestamp($startEpoch) AT TIME ZONE 'UTC')
  AND "timestamp" <  (to_timestamp($endEpoch) AT TIME ZONE 'UTC');
"@

    Push-Location $gatewayRoot
    try {
        $raw = docker compose exec -T postgres psql -U gateway -d gateway -t -A -c $sql 2>$null
        if ($LASTEXITCODE -ne 0 -or -not $raw) { return $null }
        $countText = ($raw | Select-Object -Last 1).Trim()
        $count = 0L
        if (-not [long]::TryParse($countText, [ref]$count)) { return $null }
        return ([double]$count / $steadySeconds)
    }
    catch {
        return $null
    }
    finally {
        Pop-Location
    }
}

function Get-ErrorRatePercent {
    param(
        [datetime]$AtUtc,
        [int]$WindowMinutes
    )
    $win = "${WindowMinutes}m"
    $errorExprGroups = @(
        @(
            "sum(increase(mqtt_messages_ingested_messages_total{status=`"error`"}[$win]))",
            "sum(increase(mqtt_messages_ingested_messages_total{status=`"error`"}[$win]))"
        ),
        @(
            "sum(increase(kafka_producer_messages_messages_total{status=`"error`"}[$win]))",
            "sum(increase(kafka_producer_messages_total{status=`"error`"}[$win]))"
        ),
        @(
            "sum(increase(kafka_messages_processed_messages_total{status=`"error`"}[$win]))",
            "sum(increase(kafka_messages_processed_messages_total{status=`"error`"}[$win]))"
        )
    )
    $successExprGroups = @(
        @(
            "sum(increase(mqtt_messages_ingested_messages_total{status=`"success`"}[$win]))",
            "sum(increase(mqtt_messages_ingested_messages_total{status=`"success`"}[$win]))"
        ),
        @(
            "sum(increase(kafka_producer_messages_messages_total{status=`"success`"}[$win]))",
            "sum(increase(kafka_producer_messages_total{status=`"success`"}[$win]))"
        ),
        @(
            "sum(increase(kafka_messages_processed_messages_total{status=`"success`"}[$win]))",
            "sum(increase(kafka_messages_processed_messages_total{status=`"success`"}[$win]))"
        )
    )

    function Get-FirstAvailableInstantValue {
        param([string[]]$ExprCandidates, [datetime]$AtUtc)
        foreach ($expr in $ExprCandidates) {
            $r = Invoke-PromQueryInstant -Query $expr -AtUtc $AtUtc
            if ($r.Count -gt 0) {
                return Get-PrimaryValueOrZero -Result $r
            }
        }
        return 0.0
    }

    $err = 0.0
    foreach ($group in $errorExprGroups) {
        $err += Get-FirstAvailableInstantValue -ExprCandidates $group -AtUtc $AtUtc
    }

    $ok = 0.0
    foreach ($group in $successExprGroups) {
        $ok += Get-FirstAvailableInstantValue -ExprCandidates $group -AtUtc $AtUtc
    }

    $total = $err + $ok
    if ($total -le 0) { return 0.0 }
    return ($err / $total) * 100.0
}

function Get-LagRecoverySeconds {
    param(
        [double[]]$LagValues,
        [datetime]$RangeStartUtc,
        [int]$StepSeconds,
        [datetime]$SteadyEndUtc,
        [double]$Threshold
    )
    if (-not $LagValues -or $LagValues.Count -eq 0) {
        return -1
    }
    $steadyEndOffset = [int][Math]::Floor(($SteadyEndUtc - $RangeStartUtc).TotalSeconds / $StepSeconds)
    if ($steadyEndOffset -lt 0) { $steadyEndOffset = 0 }
    if ($steadyEndOffset -ge $LagValues.Count) { $steadyEndOffset = $LagValues.Count - 1 }

    $baseline = $LagValues[$steadyEndOffset]
    for ($i = $steadyEndOffset; $i -lt $LagValues.Count; $i++) {
        if ($LagValues[$i] -le ($baseline + $Threshold)) {
            return ($i - $steadyEndOffset) * $StepSeconds
        }
    }
    return -1
}

$steadyMinutes = [int][Math]::Max(1, [Math]::Round(($SteadyEndUtc - $SteadyStartUtc).TotalMinutes))

$dbPersistStats = Get-CounterThroughputStats -CounterExprCandidates @(
    "pipeline_persisted_events_total",
    "pipeline_persisted_total"
) -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc

$dropStats = Get-CounterThroughputStats -CounterExprCandidates @(
    "pipeline_dropped_events_total",
    "pipeline_dropped_total"
) -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc

$ingestStats = Get-CounterThroughputStats -CounterExprCandidates @(
    "mqtt_messages_ingested_messages_total{status=`"success`"}",
    "mqtt_messages_ingested_messages_total{status=`"success`"}"
) -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc

$producerStats = Get-CounterThroughputStats -CounterExprCandidates @(
    "kafka_producer_messages_messages_total{status=`"success`"}",
    "kafka_producer_messages_total{status=`"success`"}"
) -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc

$consumerStats = Get-CounterThroughputStats -CounterExprCandidates @(
    "kafka_messages_processed_messages_total{status=`"success`",consumer_group=~`"$KafkaStorageConsumerGroupPattern`"}",
    "kafka_messages_processed_messages_total{status=`"success`",consumer_group=~`"$KafkaStorageConsumerGroupPattern`"}"
) -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc

$consumerAllGroupsStats = Get-CounterThroughputStats -CounterExprCandidates @(
    "kafka_messages_processed_messages_total{status=`"success`"}",
    "kafka_messages_processed_messages_total{status=`"success`"}"
) -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc
$kafkaP95Stats = Get-FirstSeriesStats -Query "histogram_quantile(0.95, sum(rate(kafka_processing_duration_seconds_bucket[5m])) by (le))" -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc
$mqttP95Stats = Get-FirstSeriesStats -Query "histogram_quantile(0.95, sum(rate(mqtt_ingest_latency_seconds_bucket[5m])) by (le))" -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc
$promUpStats = Get-FirstSeriesStats -Query "up{job=`"gateway-api`"}" -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc
$promScrapeDurationStats = Get-FirstSeriesStats -Query "scrape_duration_seconds{job=`"gateway-api`"}" -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc

$resolvedLagMetric = Resolve-ExpressionCandidate -Candidates @(
    "kafka_consumer_lag_messages{consumer_group=~`"$KafkaStorageConsumerGroupPattern`"}",
    "kafka_consumer_lag{consumer_group=~`"$KafkaStorageConsumerGroupPattern`"}",
    "kafka_consumer_lag_messages",
    "kafka_consumer_lag"
) -RangeStartUtc $SteadyStartUtc -RangeEndUtc $EndUtc

$lagQuery = if ($resolvedLagMetric) { "sum($resolvedLagMetric)" } else { "vector(0)" }
$lagSeries = Invoke-PromQueryRange -Query $lagQuery -RangeStartUtc $SteadyStartUtc -RangeEndUtc $EndUtc -StepSeconds 30
$lagValues = @()
if ($lagSeries.Count -gt 0) {
    $lagValues = Get-SeriesValues -Series $lagSeries[0]
}
$steadyLagPointCount = [int][Math]::Floor(($SteadyEndUtc - $SteadyStartUtc).TotalSeconds / 30) + 1
if ($steadyLagPointCount -gt $lagValues.Count) { $steadyLagPointCount = $lagValues.Count }
$steadyLagValues = @()
if ($steadyLagPointCount -gt 0) {
    $steadyLagValues = $lagValues[0..($steadyLagPointCount - 1)]
}
$lagStats = Get-Stats -Values $steadyLagValues
$lagRecoverySeconds = Get-LagRecoverySeconds -LagValues $lagValues -RangeStartUtc $SteadyStartUtc -StepSeconds 30 -SteadyEndUtc $SteadyEndUtc -Threshold $LagRecoveryThreshold

$errorRatePercent = Get-ErrorRatePercent -AtUtc $SteadyEndUtc -WindowMinutes $steadyMinutes

if ($EnablePostgresFallback -and $dbPersistStats.avg -le 0) {
    $dbFallbackTps = Get-DbPersistTpsFromPostgres -RangeStartUtc $SteadyStartUtc -RangeEndUtc $SteadyEndUtc
    if ($null -ne $dbFallbackTps -and $dbFallbackTps -gt 0) {
        $dbPersistStats = [pscustomobject]@{
            expr = "postgresql_fallback:telemetry_events_count"
            has_data = $true
            avg = $dbFallbackTps
            min = $dbFallbackTps
            max = $dbFallbackTps
        }
    }
}

$passDb = ($dbPersistStats.avg -ge $TargetTps)
$passDrop = ($dropStats.avg -le 0.01)
$passErr = ($errorRatePercent -lt $ErrorRateThresholdPercent)
$passKafkaP95 = ($kafkaP95Stats.max -le $KafkaP95ThresholdSeconds)
$passMqttP95 = ($mqttP95Stats.max -le $MqttP95ThresholdSeconds)
$passLag = ($lagStats.max -le ($lagStats.avg + 5000))

$sloPass = $passDb -and $passDrop -and $passErr -and $passKafkaP95 -and $passMqttP95 -and $passLag

$summary = [pscustomobject]@{
    stage_name = $StageName
    partition_count = $PartitionCount
    target_tps = $TargetTps
    db_persist_tps_avg = [Math]::Round($dbPersistStats.avg, 2)
    db_persist_tps_min = [Math]::Round($dbPersistStats.min, 2)
    db_persist_tps_max = [Math]::Round($dbPersistStats.max, 2)
    mqtt_ingest_tps_avg = [Math]::Round($ingestStats.avg, 2)
    kafka_produce_tps_avg = [Math]::Round($producerStats.avg, 2)
    kafka_consume_tps_avg = [Math]::Round($consumerStats.avg, 2)
    kafka_consume_tps_avg_all_groups = [Math]::Round($consumerAllGroupsStats.avg, 2)
    lag_avg = [Math]::Round($lagStats.avg, 2)
    lag_max = [Math]::Round($lagStats.max, 2)
    lag_recovery_seconds = $lagRecoverySeconds
    drop_rate_avg = [Math]::Round($dropStats.avg, 5)
    error_rate_percent = [Math]::Round($errorRatePercent, 5)
    kafka_p95_seconds_max = [Math]::Round($kafkaP95Stats.max, 5)
    mqtt_p95_seconds_max = [Math]::Round($mqttP95Stats.max, 5)
    prom_up_avg = [Math]::Round($promUpStats.avg, 5)
    prom_up_min = [Math]::Round($promUpStats.min, 5)
    prom_scrape_duration_seconds_avg = [Math]::Round($promScrapeDurationStats.avg, 5)
    prom_scrape_duration_seconds_max = [Math]::Round($promScrapeDurationStats.max, 5)
    metric_expr_db_persist = $dbPersistStats.expr
    metric_expr_mqtt_ingest = $ingestStats.expr
    metric_expr_kafka_produce = $producerStats.expr
    metric_expr_kafka_consume = $consumerStats.expr
    metric_expr_kafka_consume_all_groups = $consumerAllGroupsStats.expr
    metric_expr_lag = $lagQuery
    has_data_db_persist = $dbPersistStats.has_data
    has_data_mqtt_ingest = $ingestStats.has_data
    has_data_kafka_produce = $producerStats.has_data
    has_data_kafka_consume = $consumerStats.has_data
    has_data_kafka_consume_all_groups = $consumerAllGroupsStats.has_data
    pass_db_tps = $passDb
    pass_drop = $passDrop
    pass_error_rate = $passErr
    pass_kafka_p95 = $passKafkaP95
    pass_mqtt_p95 = $passMqttP95
    pass_lag = $passLag
    slo_pass = $sloPass
    start_utc = $StartUtc.ToString("o")
    steady_start_utc = $SteadyStartUtc.ToString("o")
    steady_end_utc = $SteadyEndUtc.ToString("o")
    end_utc = $EndUtc.ToString("o")
}

$jsonPath = Join-Path $OutputDir "stage-summary.json"
$summary | ConvertTo-Json -Depth 5 | Set-Content -Path $jsonPath -Encoding utf8

$csvPath = Join-Path $OutputDir "stage-summary.csv"
$csvObj = @($summary)
if (Test-Path $csvPath) {
    $csvObj | Export-Csv -Path $csvPath -NoTypeInformation -Append
}
else {
    $csvObj | Export-Csv -Path $csvPath -NoTypeInformation
}

$summary | ConvertTo-Json -Depth 5

