{
  "uid": "signalr-realtime",
  "title": "SignalR 실시간 전송",
  "tags": ["gateway", "signalr", "realtime"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Messages Sent Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by(factory_id, line_id) (rate(signalr_messages_sent_total{status=\"success\"}[5m]))",
          "legendFormat": "{{factory_id}} - {{line_id}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "legend": {
        "displayMode": "table",
        "placement": "bottom",
        "showLegend": true,
        "calcs": []
      },
      "yaxes": [
        {"format": "ops", "label": "Messages/sec"},
        {"format": "short"}
      ]
    },
    {
      "id": 2,
      "title": "Send Latency (P95/P99)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(signalr_send_latency_seconds_bucket[5m])) by (le, factory_id, line_id))",
          "legendFormat": "P95 {{factory_id}} - {{line_id}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(signalr_send_latency_seconds_bucket[5m])) by (le, factory_id, line_id))",
          "legendFormat": "P99 {{factory_id}} - {{line_id}}",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "legend": {
        "displayMode": "table",
        "placement": "bottom",
        "showLegend": true,
        "calcs": []
      },
      "yaxes": [
        {"format": "s", "label": "Latency"},
        {"format": "short"}
      ]
    },
    {
      "id": 3,
      "title": "Total Messages Sent",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(signalr_messages_sent_total{status=\"success\"})",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 4,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "sum(signalr_connected_clients)",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 5,
      "title": "Send Errors",
      "type": "graph",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "sum by(factory_id, line_id) (rate(signalr_messages_sent_total{status=\"error\"}[5m]))",
          "legendFormat": "{{factory_id}} - {{line_id}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "legend": {
        "displayMode": "table",
        "placement": "bottom",
        "showLegend": true,
        "calcs": []
      },
      "yaxes": [
        {"format": "ops", "label": "Errors/sec"},
        {"format": "short"}
      ]
    }
  ]
}
