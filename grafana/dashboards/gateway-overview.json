{
  "uid": "gateway-overview",
  "title": "Gateway System Overview",
  "tags": ["gateway", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Throughput",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(pipeline_ingested_total[5m])",
          "legendFormat": "Ingested",
          "refId": "A"
        },
        {
          "expr": "rate(pipeline_persisted_total[5m])",
          "legendFormat": "Persisted",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "ops", "label": "Events/sec"},
        {"format": "short"}
      ]
    },
    {
      "id": 2,
      "title": "Pipeline Queue Lengths",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "pipeline_stage_queue_length",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Queue Length"},
        {"format": "short"}
      ]
    },
    {
      "id": 3,
      "title": "Kafka Consumer Lag",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(kafka_consumer_lag) by (consumer_group)",
          "legendFormat": "{{consumer_group}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Lag"},
        {"format": "short"}
      ]
    },
    {
      "id": 4,
      "title": "Pipeline Processing Duration (P95)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, pipeline_processing_duration_seconds_bucket)",
          "legendFormat": "P95",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Duration"},
        {"format": "short"}
      ]
    }
  ]
}
